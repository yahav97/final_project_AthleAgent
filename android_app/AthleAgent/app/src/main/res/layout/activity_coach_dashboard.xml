<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_dash"
    android:baselineAligned="false"
    android:orientation="horizontal"
    android:padding="@dimen/spacing_8">

    <!-- Team Roster Card -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1.1"
        android:layout_margin="@dimen/spacing_8"
        app:cardBackgroundColor="@color/white"
        app:cardCornerRadius="@dimen/radius_medium"
        app:cardElevation="@dimen/elevation_medium"
        app:strokeWidth="0dp">

        <androidx.appcompat.widget.LinearLayoutCompat
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <com.google.android.material.textview.MaterialTextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/team_roster"
                android:textSize="@dimen/team_text_size"
                android:fontFamily="@font/roboto_bold"
                android:textColor="@color/text"
                android:padding="@dimen/spacing_20"
                android:gravity="center_horizontal"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/bright_gray"
                android:layout_marginHorizontal="@dimen/spacing_20"/>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/coachDash_RV_athletes"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:padding="@dimen/spacing_8"/>
        </androidx.appcompat.widget.LinearLayoutCompat>
    </com.google.android.material.card.MaterialCardView>

    <!-- Details Container -->
    <androidx.appcompat.widget.LinearLayoutCompat
        android:id="@+id/coachDash_layout_details"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="2.4"
        android:orientation="vertical"
        android:padding="@dimen/spacing_8"
        android:visibility="invisible">

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/coachDash_TXT_athleteName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/select_an_athlete"
            android:textSize="@dimen/headline_text_size"
            android:fontFamily="@font/roboto_bold"
            android:textColor="@color/text"
            android:layout_marginBottom="@dimen/spacing_12"
            android:layout_marginStart="@dimen/spacing_8"/>

        <!-- Risk Score Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/coachDash_CARD_risk"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/spacing_8"
            app:cardBackgroundColor="@color/white"
            app:cardCornerRadius="@dimen/radius_large"
            app:cardElevation="@dimen/elevation_medium"
            app:strokeWidth="0dp">

            <androidx.appcompat.widget.LinearLayoutCompat
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="@dimen/spacing_24"
                android:paddingTop="@dimen/spacing_12"
                android:paddingBottom="@dimen/spacing_8"
                android:gravity="center">

                <RelativeLayout
                    android:layout_width="@dimen/dial_size_coach"
                    android:layout_height="@dimen/dial_size_coach">

                    <ProgressBar
                        android:id="@+id/coachDash_PRG_riskScore"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:indeterminate="false"
                        android:max="100"
                        android:progress="0"
                        android:progressDrawable="@drawable/progress_drawable_green" />

                    <androidx.appcompat.widget.LinearLayoutCompat
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:gravity="center">

                        <com.google.android.material.textview.MaterialTextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/daily_risk_score1"
                            android:textSize="@dimen/text_size_label_small"
                            android:fontFamily="@font/roboto_bold"
                            android:textColor="@color/charcoal_black"/>

                        <com.google.android.material.textview.MaterialTextView
                            android:id="@+id/coachDash_TXT_score"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="--%"
                            android:textSize="@dimen/text_size_score_medium"
                            android:fontFamily="@font/roboto_bold"
                            android:textColor="@color/brand_button_dark_muted"
                            android:layout_marginTop="-6dp"
                            android:layout_marginBottom="-6dp"/>

                        <com.google.android.material.textview.MaterialTextView
                            android:id="@+id/coachDash_TXT_confidence"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Confidence: --%"
                            android:textSize="@dimen/text_size_label_small"
                            android:fontFamily="@font/roboto_bold"
                            android:textColor="@color/brand_button_light_muted"/>
                    </androidx.appcompat.widget.LinearLayoutCompat>
                </RelativeLayout>

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/coachDash_TXT_aiRecommendation"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/analyzing_data"
                    android:textSize="@dimen/text_size_input_label"
                    android:textColor="@color/text"
                    android:textAlignment="center"
                    android:fontFamily="@font/roboto_regular"
                    android:lineSpacingExtra="4dp"
                    android:layout_marginTop="@dimen/spacing_4"/>
            </androidx.appcompat.widget.LinearLayoutCompat>
        </com.google.android.material.card.MaterialCardView>

        <!-- History Chart Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/coachDash_CARD_history"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            app:cardBackgroundColor="@color/white"
            app:cardCornerRadius="@dimen/radius_large"
            app:cardElevation="@dimen/elevation_medium"
            app:strokeWidth="0dp">

            <androidx.appcompat.widget.LinearLayoutCompat
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:paddingHorizontal="@dimen/spacing_24"
                android:paddingVertical="@dimen/spacing_12">

                <androidx.appcompat.widget.LinearLayoutCompat
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="@dimen/spacing_12">

                    <androidx.appcompat.widget.AppCompatImageView
                        android:layout_width="@dimen/spacing_24"
                        android:layout_height="@dimen/spacing_24"
                        android:contentDescription="@string/risk_logo1"
                        android:src="@android:drawable/ic_dialog_info"
                        app:tint="@color/brand_button_light_muted"
                        android:layout_marginEnd="@dimen/spacing_8"/>

                    <com.google.android.material.textview.MaterialTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/risk_score_last_7_days1"
                        android:fontFamily="@font/roboto_bold"
                        android:textSize="@dimen/text_size_label_medium"
                        android:textColor="@color/text"/>
                </androidx.appcompat.widget.LinearLayoutCompat>

                <com.github.mikephil.charting.charts.LineChart
                    android:id="@+id/coachDash_CHART_history"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginTop="@dimen/spacing_4" />

            </androidx.appcompat.widget.LinearLayoutCompat>
        </com.google.android.material.card.MaterialCardView>

    </androidx.appcompat.widget.LinearLayoutCompat>

</androidx.appcompat.widget.LinearLayoutCompat>