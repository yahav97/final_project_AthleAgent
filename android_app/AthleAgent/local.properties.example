## Copy to local.properties (Android Studio usually creates sdk.dir automatically).
## sdk.dir is machine-specific — do not commit local.properties.

sdk.dir=C\:\\Users\\YOUR_USER\\AppData\\Local\\Android\\Sdk

## Meal photo analysis (Gemini Vision). Provided with the project submission — not committed.
## Risk scoring works without this key; meal-photo analysis requires it.
GEMINI_API_KEY=
