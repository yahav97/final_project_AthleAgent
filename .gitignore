serviceAccountKey.json
*serviceAccount*.json
firebase-adminsdk*.json

# Logs
logs/
*.log

# Database
*.db
*.sqlite

# IDE
.vscode/
.idea/
*.swp
*.swo

# Local scratch / caches (never ship)
tmp_book_extract/
.pytest_cache/
**/pytest-cache-files-*/
**/.artifacts/

# OS
.DS_Store
Thumbs.db

# ML synthetic outputs (regenerate: ML_model/run_pipeline.py or data_generator.py + create_benchmark_set.py)
ML_model/athlete_injury_data.csv
